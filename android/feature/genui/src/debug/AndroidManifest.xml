<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only (src/debug): GenUI preview and ad-hoc card injection. Never in release.
     The R1 runs this debug APK, so both entry points require DUMP: adb shell holds it,
     installed third-party apps cannot, so no other app can inject cards or "say" buttons. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity
            android:name="com.resonolabs.feature.genui.GenUiPreviewActivity"
            android:permission="android.permission.DUMP"
            android:configChanges="density|fontScale|keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen" />

        <receiver
            android:name="com.resonolabs.feature.genui.GenUiDebugReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.resonolabs.genui.DEBUG_SHOW" />
                <action android:name="com.resonolabs.genui.DEBUG_UPDATE" />
                <action android:name="com.resonolabs.genui.DEBUG_DISMISS" />
                <action android:name="com.resonolabs.genui.DEBUG_SCENE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
