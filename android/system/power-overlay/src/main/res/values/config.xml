<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 3 = MULTI_PRESS_POWER_LAUNCH_TARGET_ACTIVITY: a power double press starts
         config_doublePressOnPowerTargetActivity (per build type, see src/debug and src/release).
         Settings.Global power_button_double_press overrides this live when set. -->
    <integer name="config_doublePressOnPowerBehavior">3</integer>
    <!-- 0 = off. Stock CipherOS uses 2 (camera/wallet double tap), which launches the camera AND
         resets PhoneWindowManager's power gesture detector, so our double press would never fire. -->
    <integer name="config_doubleTapPowerGestureMode">0</integer>
    <!-- The emergency gesture intercepts the second consecutive tap while the screen is on and
         also resets the detector. -->
    <bool name="config_emergencyGestureEnabled">false</bool>
    <!-- No navigation bar: SamRabbit is a full-screen HOME with its own Back (left-edge swipe and
         on-screen buttons). Without this, a swipe up from the bottom reveals the bars, starts
         Launcher3's home/recents gesture and reads as a status-bar pull that opens Control Center. -->
    <bool name="config_showNavigationBar">false</bool>
</resources>
